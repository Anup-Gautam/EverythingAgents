GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
FIREBASE_PROJECT_ID=your-project-id
GCS_BUCKET=your-bucket-name
PORT=8080

# Gemini (keep this out of git; never paste in chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated extras tried on 503/429 (primary is always tried first)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash

# Preferred voice (low latency)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-turbo
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
CARTESIA_VERSION=2025-04-16

# Optional fallback if Groq/Cartesia unset or fail
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=flux-alexis-en
